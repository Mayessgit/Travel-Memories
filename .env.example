# Copiez ce fichier en .env (API)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/travel_memories
JWT_SECRET=change-me-with-a-long-random-string
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# URL publique de l'API : sert à construire les liens des photos (/uploads/...)
PUBLIC_URL=http://localhost:8000
# Taille maximale des vidéos publiées (100 Mo)
MAX_VIDEO_SIZE=104857600
# Stockage local dans le volume Docker ; utiliser "cloudinary" en production avec ses clés configurées.
STORAGE_DRIVER=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
